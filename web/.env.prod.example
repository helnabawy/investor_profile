# PRODUCTION build. Copy to .env.prod.local and fill in; used by `pnpm build:prod` / `pnpm start:prod`.
# On Vercel put these values in the *Production* environment instead (Settings → Environment Variables).
# List every key here, even empty: a key missing from this file falls back to .env.local (your local dev values).

# ───────── Deployment mode ─────────
# multi  = SaaS: tenants at <slug>.$NEXT_PUBLIC_ROOT_DOMAIN or their custom domains; /signup enabled
# single = self-hosted for one client: every request serves TENANT_SLUG; signup disabled
DEPLOY_MODE=multi
NEXT_PUBLIC_ROOT_DOMAIN=yourdomain.com
TENANT_SLUG=demo

# ───────── Supabase ─────────
NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Signs theme-preview links and salts visitor rate-limit hashes. Falls back to the service role key; set it to rotate independently.
PREVIEW_SECRET=

# ───────── AI (set at least one; the concierge falls back between them) ─────────
GOOGLE_GENERATIVE_AI_API_KEY=   # Gemini — free tier (GEMINI_API_KEY also accepted)
GROQ_API_KEY=                   # Groq — free tier, Llama 3.3 70B
OPENROUTER_API_KEY=             # OpenRouter — many cheap/free models
ANTHROPIC_API_KEY=              # Claude Haiku — low cost, best quality

# ───────── Optional ─────────
RESEND_API_KEY=                 # lead notification emails (otherwise logged to console)
LEADS_FROM_EMAIL=               # e.g. "EstateProfile <leads@yourdomain.com>"
NEXT_PUBLIC_PLATFORM_URL=https://yourdomain.com  # link for the "Powered by" badge on free sites
VERCEL_TOKEN=                   # auto-register custom domains on Vercel (multi mode)
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
