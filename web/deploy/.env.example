# Settings for the VPS install (docker-compose.prod.yml). Copy to deploy/.env and fill in.
# Guide: docs/DEPLOYMENT-VPS.md

# ───────── Domain ─────────
# Your platform domain, no https:// and no trailing slash. Tenant sites live at <slug>.<ROOT_DOMAIN>.
ROOT_DOMAIN=yourdomain.com
# Public address of the Supabase API (login and image uploads call it from the browser).
SUPABASE_PUBLIC_URL=https://api.yourdomain.com

# multi  = SaaS: many tenants, /signup enabled
# single = one client's own install: every request serves TENANT_SLUG
DEPLOY_MODE=multi
TENANT_SLUG=demo

# ───────── Cloudflare ─────────
# Tunnel token: Zero Trust → Networks → Tunnels → your tunnel → "Install connector" (the long eyJ… string).
TUNNEL_TOKEN=
# Optional: registers tenants' custom domains automatically (Cloudflare for SaaS).
# Token needs the "SSL and Certificates: Edit" permission on the zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Where clients point their CNAME record. Defaults to customers.<ROOT_DOMAIN>.
CUSTOM_DOMAIN_CNAME=

# ───────── AI (set at least one; the concierge falls back between them) ─────────
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ───────── Email ─────────
# Lead notifications (without these they are only written to the app log).
RESEND_API_KEY=
LEADS_FROM_EMAIL=
# Sign-up confirmation and password emails. For Resend: host smtp.resend.com, port 465,
# user "resend", password = a Resend API key, sender on a verified domain.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EstateProfile
# true = accounts work straight after sign-up. Set to false once the SMTP settings above are tested.
AUTH_AUTOCONFIRM=true

# ───────── Backups (deploy/backup.sh) ─────────
BACKUP_DIR=/var/backups/estateprofile
BACKUP_KEEP_DAYS=14
# Optional off-site copy: an rclone remote and path, e.g. r2:estateprofile-backups
BACKUP_RCLONE_REMOTE=

# ───────── Secrets ─────────
# Do not type these by hand. Append them with:  node scripts/gen-secrets.mjs >> deploy/.env
# (POSTGRES_PASSWORD, JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, PREVIEW_SECRET)
